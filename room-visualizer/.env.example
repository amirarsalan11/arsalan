# Room Visualizer SaaS — root environment configuration
# Copy this file to .env before running `docker compose up`.

# --- App ---
ENVIRONMENT=development
APP_NAME=room-visualizer-api
LOG_LEVEL=info

# --- Database ---
POSTGRES_USER=roomviz
POSTGRES_PASSWORD=changeme
POSTGRES_DB=roomviz
DATABASE_URL=postgresql+psycopg://roomviz:changeme@postgres:5432/roomviz

# --- Redis / Celery ---
# NOTE: not consumed by any code yet (Async Worker System is Milestone 13).
# Present here only so infra/docker-compose.yml has a single source of truth.
REDIS_URL=redis://redis:6379/0

# --- Storage (placeholders only — not implemented yet) ---
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT_URL=

# --- Authentication ---
# Server-side "pepper" used to key the HMAC-SHA256 hash of raw API
# keys. NEVER stored in the database. Generate a long random value for
# any real deployment, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this value invalidates every previously issued API key.
API_KEY_HASH_SECRET=change-me-to-a-long-random-value
