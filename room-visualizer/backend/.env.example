ENVIRONMENT=development
APP_NAME=room-visualizer-api
LOG_LEVEL=info
DATABASE_URL=postgresql+psycopg://roomviz:changeme@postgres:5432/roomviz

# Server-side pepper for HMAC-SHA256 API key hashing. Never stored in
# the database. See root .env.example for generation guidance.
API_KEY_HASH_SECRET=change-me-to-a-long-random-value
